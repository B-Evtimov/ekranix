<Window x:Class="Ekranix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekranix" Height="480" Width="520">
    <Grid Margin="20">

        <!-- Списък с телевизори + код -->
        <StackPanel x:Name="ListPanel">
            <TextBlock Text="Телевизори в мрежата" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Button x:Name="ScanBtn" Content="Търси" Click="Scan_Click" Padding="10" Margin="0,0,0,10"/>
            <ListBox x:Name="TvList" Height="200"/>

            <TextBlock Text="Код от телевизора:" Margin="0,14,0,4"/>
            <DockPanel>
                <Button x:Name="ConnectBtn" DockPanel.Dock="Right" Content="Свържи"
                        Click="Connect_Click" Padding="18,6" Margin="8,0,0,0"/>
                <TextBox x:Name="CodeBox" MaxLength="7" FontSize="22" FontFamily="Consolas"
                         VerticalContentAlignment="Center" KeyDown="CodeBox_KeyDown"/>
            </DockPanel>

            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Свързан -->
        <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="ConnectedText" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="(предаването на екрана идва в следващата стъпка)" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,6,0,24"/>
            <Button Content="Прекъсни" Click="Disconnect_Click" Padding="24,8" HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>